{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "bun *": "allow",
      "git *": "allow",
      "*selfloop.py*": "allow",
      "*PythonEmbed*": "allow",
      "git push *": "deny",
      "git reset *": "deny",
      "git clean *": "deny",
      "git checkout *": "deny",
      "git checkout -- *": "allow",
      "rm *": "deny",
      "Remove-Item *": "deny",
      "del *": "deny"
    }
  }
}
